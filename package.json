{
  "name": "terminal-groups",
  "displayName": "Terminal Groups",
  "description": "Terminal list grouped by workspace folder.",
  "version": "0.0.1",
  "publisher": "jnarowski",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.93.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "test": "node --test",
    "package": "pnpm dlx @vscode/vsce package --no-dependencies --allow-missing-repository --skip-license -o terminal-groups.vsix",
    "install-local": "pnpm run package && cursor --install-extension terminal-groups.vsix --force"
  },
  "contributes": {
    "viewsContainers": {
      "panel": [
        {
          "id": "terminalGroups",
          "title": "Terminal Groups",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "terminalGroups": [
        {
          "id": "terminalGroups.tree",
          "name": "Terminals"
        }
      ]
    },
    "commands": [
      { "command": "terminalGroups.show", "title": "Show Terminal" },
      { "command": "terminalGroups.kill", "title": "Kill Terminal", "icon": "$(trash)" },
      { "command": "terminalGroups.rename", "title": "Rename..." },
      { "command": "terminalGroups.changeColor", "title": "Change Color..." },
      { "command": "terminalGroups.changeIcon", "title": "Change Icon..." },
      { "command": "terminalGroups.moveToEditor", "title": "Move into Editor Area" },
      { "command": "terminalGroups.split", "title": "Split Terminal" },
      { "command": "terminalGroups.newInFolder", "title": "New Terminal Here", "icon": "$(add)" },
      { "command": "terminalGroups.expandAll", "title": "Expand All", "icon": "$(expand-all)" }
    ],
    "menus": {
      "view/title": [
        { "command": "terminalGroups.expandAll", "when": "view == terminalGroups.tree", "group": "navigation@1" }
      ],
      "view/item/context": [
        { "command": "terminalGroups.newInFolder", "when": "view == terminalGroups.tree && viewItem == group", "group": "inline" },
        { "command": "terminalGroups.newInFolder", "when": "view == terminalGroups.tree && viewItem == group", "group": "1_group@1" },
        { "command": "terminalGroups.kill", "when": "view == terminalGroups.tree && viewItem == terminal", "group": "inline" },
        { "command": "terminalGroups.split", "when": "view == terminalGroups.tree && viewItem == terminal", "group": "1_terminal@1" },
        { "command": "terminalGroups.moveToEditor", "when": "view == terminalGroups.tree && viewItem == terminal", "group": "1_terminal@2" },
        { "command": "terminalGroups.rename", "when": "view == terminalGroups.tree && viewItem == terminal", "group": "2_edit@1" },
        { "command": "terminalGroups.changeColor", "when": "view == terminalGroups.tree && viewItem == terminal", "group": "2_edit@2" },
        { "command": "terminalGroups.changeIcon", "when": "view == terminalGroups.tree && viewItem == terminal", "group": "2_edit@3" },
        { "command": "terminalGroups.kill", "when": "view == terminalGroups.tree && viewItem == terminal", "group": "3_kill@1" }
      ],
      "commandPalette": [
        { "command": "terminalGroups.show", "when": "false" },
        { "command": "terminalGroups.kill", "when": "false" },
        { "command": "terminalGroups.rename", "when": "false" },
        { "command": "terminalGroups.changeColor", "when": "false" },
        { "command": "terminalGroups.changeIcon", "when": "false" },
        { "command": "terminalGroups.moveToEditor", "when": "false" },
        { "command": "terminalGroups.split", "when": "false" },
        { "command": "terminalGroups.newInFolder", "when": "false" }
      ]
    }
  }
}
